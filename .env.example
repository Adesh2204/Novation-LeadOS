LEADOS_MODE=mock
ENABLE_EMAIL_SEND=false
SEARCH_PROVIDER=mock # mock or exa
CRAWLER_PROVIDER=mock
LLM_PROVIDER=mock
EMBEDDING_PROVIDER=mock
CONTACT_PROVIDER=mock
CRM_PROVIDER=mock
EMAIL_PROVIDER=mock
LEADOS_STORAGE=mock
MOCK_STORAGE_PATH=./data/leados.json
GOOGLE_SHEETS_ENABLED=false
SHOW_TECHNICAL_SHEETS=false
GOOGLE_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=
# Alternative to a credential file: GOOGLE_SERVICE_ACCOUNT_JSON=
STORAGE_LOCK_PATH=./data/storage-writer.lock
STORAGE_OUTBOX_PATH=./data/sheets-outbox.json
SHEETS_TIMEOUT_SECONDS=15
SHEETS_MAX_ATTEMPTS=3
SHEETS_REQUESTS_PER_MINUTE=45
SHEETS_MAX_ROWS=10000
# Used only by the optional legacy SQL import/migration tools:
# DATABASE_URL=sqlite:///./data/leados.db
N8N_ENCRYPTION_KEY=replace-with-a-long-local-random-string
N8N_SECURE_COOKIE=false
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
PROVIDER_TIMEOUT_SECONDS=30
PROVIDER_MAX_ATTEMPTS=3
# Live Provider Credentials
EXA_API_KEY=
FIRECRAWL_API_KEY=

# Live Research Controls
LIVE_DISCOVERY_ENABLED=false
RUN_LIVE_PROVIDER_TESTS=false
LIVE_PROVIDER_DRY_RUN=true

# Credit-Safe Limits
MAX_EXA_SEARCHES_PER_RUN=10
MAX_EXA_RESULTS_PER_QUERY=10
MAX_EXA_CANDIDATES_PER_RUN=50

MAX_FIRECRAWL_COMPANIES_PER_RUN=10
MAX_FIRECRAWL_PAGES_PER_COMPANY=4
MAX_FIRECRAWL_PAGES_PER_RUN=25

# Cache TTL Controls (hours)
FIRECRAWL_CACHE_TTL_HOURS=168
EXA_SEARCH_CACHE_TTL_HOURS=12

# Optional live adapters; mock discovery always stays local.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CONTACT_OUT_API_KEY=
SNOVIO_USER_ID=
SNOVIO_SECRET=
HUBSPOT_ACCESS_TOKEN=
LIVE_RESEARCH_MODE=EXA_FIRECRAWL
# For full AI research: LLM_PROVIDER=openai, EMBEDDING_PROVIDER=openai,
# CONTACT_PROVIDER=contactout_snovio, CRM_PROVIDER=hubspot, LIVE_RESEARCH_MODE=FULL_LIVE.
# n8n and SMTP are optional; the pipeline does not depend on either.
N8N_URL=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=

# Bounded parallel search, crawl and research; the dashboard stays responsive.
LIVE_PROVIDER_CONCURRENCY=3
# Discovery progress persists under data/discovery-jobs by default.
